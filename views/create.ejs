<%- include("partials/header.ejs") %>

<main class="form-container">
    <header class="page-header">
        <h1>Create a New Post</h1>
    </header>

    <!-- The action attribute will tell Express where to send the data -->
    <form action="/submit" method="POST" class="editor-form">
        
        <div class="form-group">
            <label for="postTitle">Title</label>
            <input type="text" id="postTitle" name="title" placeholder="Give your post a catchy title..." required>
        </div>

        <div class="form-group">
            <label for="postContent">Content</label>
            <textarea id="postContent" name="content" rows="12" placeholder="What's on your mind?" required></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Publish</button>
            <a href="/" class="btn-cancel">Cancel</a>
        </div>

    </form>
</main>

<%- include("partials/footer.ejs") %>